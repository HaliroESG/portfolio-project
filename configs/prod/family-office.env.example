# Backend command API and jobs. Never expose the secret key to the browser.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SECRET_KEY=replace_with_backend_secret
FRONTEND_ORIGINS=https://portfolio.example.com,http://localhost:3000

# Frontend public runtime.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
NEXT_PUBLIC_COMMAND_API_URL=https://portfolio-api.example.com

# CI-only private contract smoke.
SUPABASE_SMOKE_KEY=replace_with_backend_secret
