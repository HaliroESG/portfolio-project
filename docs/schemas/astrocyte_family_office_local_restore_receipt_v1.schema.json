{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haliro.invalid/schemas/astrocyte_family_office_local_restore_receipt_v1.schema.json",
  "title": "ASTROCYTE Family Office local restore receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "started_at",
    "completed_at",
    "release_gate_sha",
    "candidate_sha",
    "candidate_manifest_sha256",
    "migration_sha256",
    "backup_sha256",
    "source_fingerprint_sha256",
    "restored_fingerprint_sha256",
    "restore_mode",
    "postgres_major",
    "rpo_seconds",
    "rto_seconds",
    "owner_identity_count",
    "read_isolation",
    "write_isolation",
    "composite_constraints",
    "rls_grants_views",
    "rollback_verified",
    "unsafe_rollback_refused",
    "outbound_side_effects",
    "cleanup_status"
  ],
  "properties": {
    "schema_version": {"const": "astrocyte_family_office_local_restore_receipt_v1"},
    "status": {"const": "PASS"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "release_gate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "migration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backup_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "restored_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "restore_mode": {"const": "LOCAL_ISOLATED_DATABASE"},
    "postgres_major": {"type": "integer", "minimum": 15},
    "rpo_seconds": {"type": "number", "minimum": 0},
    "rto_seconds": {"type": "number", "minimum": 0},
    "owner_identity_count": {"const": 2},
    "read_isolation": {"const": true},
    "write_isolation": {"const": true},
    "composite_constraints": {"const": true},
    "rls_grants_views": {"const": true},
    "rollback_verified": {"const": true},
    "unsafe_rollback_refused": {"const": true},
    "outbound_side_effects": {"const": false},
    "cleanup_status": {"const": "DELETED"}
  }
}
